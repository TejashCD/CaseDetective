{
  "name": "casedetective",
  "version": "2.0.0",
  "description": "CaseDetective: turn your study notes into a detective game. Earn every clue by explaining the concept to an AI character.",
  "private": true,
  "type": "module",
  "main": "dist/server/main.js",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && npm run copy-public",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "copy-public": "node -e \"require('node:fs').cpSync('public', 'dist/web', { recursive: true })\"",
    "start": "node dist/server/main.js",
    "dev": "concurrently -k -n web,server -c blue,green \"tsc -p tsconfig.client.json --watch --preserveWatchOutput\" \"node --watch src/server/main.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
